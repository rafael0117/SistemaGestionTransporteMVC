@{
    ViewData["Title"] = "informacionViaje";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="container">
    <!-- Título y Breadcrumb -->
    <h1 class="mt-4 mb-3">
        CIVA <small>Detalles del Viaje</small>
    </h1>

    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Inicio</a></li>
        <li class="breadcrumb-item active">Viaje</li>
    </ol>

    <!-- Detalle del viaje -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <!-- Imagen del viaje -->
                <!-- Información del viaje -->
                <div class="col-lg-6">
                    <form asp-controller="Carrito" asp-action="Agregar" method="post" id="formReservar">
                        <div class="card">
                            <div class="card-body">
                                <h2 class="card-title">Viaje #@Model.IdViaje</h2>

                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <h5>Precio: S/ @Model.Precio</h5>
                                    </li>
                                    <li class="list-group-item">
                                        <p><strong>Salida:</strong> @Model.FechaSalida.ToString("dd/MM/yyyy hh:mm tt")</p>
                                        <p><strong>Llegada:</strong> @Model.FechaLlegada.ToString("dd/MM/yyyy hh:mm tt")</p>
                                    </li>
                                    <li class="list-group-item">
                                        <label for="cantidad"><strong>Cantidad:</strong></label>
                                        <input type="number" name="cantidad" id="cantidad" class="form-control w-50 d-inline-block"
                                               min="1" max="5" value="1" required />
                                    </li>
                                </ul>

                                <!-- ID del viaje oculto -->
                                <input type="hidden" name="idViaje" value="@Model.IdViaje" id="idViaje" />


                                <button type="submit" class="btn btn-dark mt-3">Reservar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.getElementById("formReservar").addEventListener("submit", async function (e) {
            e.preventDefault(); // Evita que el formulario se envíe normalmente

            const idViaje = document.getElementById("idViaje").value;
            const cantidad = document.getElementById("cantidad").value;

            // Hacer el POST usando Fetch
            const response = await fetch("/Carrito/Agregar", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ idViaje: idViaje, cantidad: cantidad })
            });

            const result = await response.json();

            // Si el usuario no está logueado
            if (result.status === "not_logged_in") {
                Swal.fire({
                    icon: 'warning',
                    title: 'Debe iniciar sesión',
                    text: 'Necesita iniciar sesión para reservar un viaje.',
                    showCancelButton: true,
                    confirmButtonText: 'Ir a iniciar sesión',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Usuario/Login'; // Redirige al login
                    }
                });
            } else if (result.status === "success") {
                // Si el viaje fue agregado con éxito
                Swal.fire("¡Agregado!", result.message, "success").then(() => {
                    window.location.href = "/Carrito/Index"; // Redirige al carrito
                });
            } else {
                // Si hubo un error
                Swal.fire("Error", result.message, "error");
            }
        });
    </script>
}
