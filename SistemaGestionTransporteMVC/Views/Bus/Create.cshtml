@model SistemaGestionTransporteMVC.Models.Bus

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-5">
    <div class="card bg-dark text-white shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h2 class="mb-0 fw-bold">Crear Nuevo Bus</h2>
        </div>
        <div class="card-body px-5 py-4">
            <form asp-action="Create" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger text-white border-0 rounded-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Modelo" class="form-label fw-semibold">Modelo</label>
                        <input asp-for="Modelo" class="form-control bg-secondary text-white border-0 rounded-3" />
                        <span asp-validation-for="Modelo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Marca" class="form-label fw-semibold">Marca</label>
                        <input asp-for="Marca" class="form-control bg-secondary text-white border-0 rounded-3" />
                        <span asp-validation-for="Marca" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Anio" class="form-label fw-semibold">Año</label>
                        <input asp-for="Anio" class="form-control bg-secondary text-white border-0 rounded-3" />
                        <span asp-validation-for="Anio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacidad" class="form-label fw-semibold">Capacidad</label>
                        <input asp-for="Capacidad" class="form-control bg-secondary text-white border-0 rounded-3" />
                        <span asp-validation-for="Capacidad" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Placa" class="form-label fw-semibold">Placa</label>
                        <input asp-for="Placa" class="form-control bg-secondary text-white border-0 rounded-3" />
                        <span asp-validation-for="Placa" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-success px-4 me-2 rounded-pill shadow-sm">Guardar</button>
                    <a asp-action="Index" class="btn btn-outline-light px-4 rounded-pill shadow-sm">Regresar</a>
                </div>
            </form>
        </div>
    </div>
</div>
